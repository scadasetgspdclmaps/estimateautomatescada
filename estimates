      p([tr('Sub:-\t'), tr(`TGSPDCL – SCADA Circle – Hyd – Estimate for ${d.work_desc}${d.consumer_name ? ' on request of consumer '+d.consumer_name : ''} – Submitted for Necessary Sanction – Reg.`)],
