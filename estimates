// ═══════════════ SUBMIT / DOWNLOAD ═══════════════
async function submitDoc() {
  const d = collectData();
  const err = validate(d);
  if (err) { toast(err, true); return; }

  const recs = getRecords();
  d.id = Date.now();
  recs.push(d);
  saveRecords(recs);

  await doDownload(d);
  toast('✅ Saved & downloading!');
}

async function downloadOnly() {
  const d = collectData();
  const err = validate(d);
  if (err) { toast(err, true); return; }
  await doDownload(d);
  toast('📄 Document downloaded!');
}

async function doDownload(d) {
  const doc = await buildDocx(d);
  const blob = await window.docx.Packer.toBlob(doc);
  const typeLabel = {PM:'PM_Order', Z:'Z_Estimate', CGM:'CGM_Letter'}[d.doc_type] || 'Doc';
  const fname = `${typeLabel}_DNo${d.d_no || '___'}_${d.estimate_no || 'Est'}_${d.division || ''}.docx`;
  saveAs(blob, fname);
}

// ═══════════════ STORAGE ═══════════════
function getRecords() {
  try { return JSON.parse(localStorage.getItem(STORE)) || []; }
  catch { return []; }
}
function saveRecords(arr) { localStorage.setItem(STORE, JSON.stringify(arr)); }

// ═══════════════ RECORDS TABLE ═══════════════
function renderTable() {
  const recs = getRecords();
  const q = (document.getElementById('search-input')?.value || '').toLowerCase();
  const filtered = q ? recs.filter(r =>
    [r.estimate_no, r.division, r.d_no, r.work_desc, r.subdivision]
      .join(' ').toLowerCase().includes(q)
  ) : recs;

  document.getElementById('count-badge').textContent = recs.length;
  const tbody = document.getElementById('records-tbody');
  if (!filtered.length) {
    tbody.innerHTML = '<tr><td colspan="10" class="no-data">No records found.</td></tr>';
    return;
  }
  const typeClass = {PM:'type-pm', Z:'type-z', CGM:'type-cgm'};
  const typeLabel = {PM:'PM Order', Z:'Z-Est.', CGM:'CGM Lr.'};
  tbody.innerHTML = filtered.map(r => {
    const amt = r.doc_type==='Z'
      ? '₹'+parseInt(r.amount_g||0).toLocaleString('en-IN')+' (G)'
      : r.amount ? '₹'+parseInt(r.amount).toLocaleString('en-IN') : '—';
    const idx = recs.findIndex(x => x.id === r.id);
    return `<tr>
      <td>${idx+1}</td>
      <td><span class="type-badge ${typeClass[r.doc_type]||''}">${typeLabel[r.doc_type]||r.doc_type}</span></td>
      <td>${fmtDate(r.memo_date)}</td>
      <td>${r.d_no||'—'}</td>
      <td><b>${r.estimate_no||'—'}</b></td>
      <td>${r.division||'—'}</td>
      <td>${r.subdivision||'—'}</td>
      <td>${amt}</td>
      <td style="font-size:11px;color:#888">${r.saved_on||'—'}</td>
      <td style="display:flex;gap:6px">
        <button class="btn btn-blue" style="font-size:11px;padding:5px 10px"
          onclick="reDownload(${idx})">⬇ docx</button>
        <button class="btn btn-red"
          onclick="deleteRec(${idx})">✕</button>
      </td>
    </tr>`;
  }).join('');
}

async function reDownload(idx) {
  const recs = getRecords();
  if (!recs[idx]) return;
  await doDownload(recs[idx]);
  toast('📄 Re-downloaded!');
}

function deleteRec(idx) {
  if (!confirm('Delete this record?')) return;
  const recs = getRecords(); recs.splice(idx,1); saveRecords(recs); renderTable();
  toast('Deleted');
}
function clearAll() {
  if (!confirm('Delete ALL records? Cannot be undone.')) return;
  localStorage.removeItem(STORE); renderTable(); toast('All cleared');
}

// ═══════════════ CSV EXPORT ═══════════════
function exportCSV() {
  const recs = getRecords();
  if (!recs.length) { toast('No records', true); return; }
  const cols = ['doc_type','memo_date','d_no','fy_short','estimate_no','division','subdivision',
    'work_desc','amount','amount_g','amount_n','in_words','sanction_no','saved_on'];
  const csv = [cols.join(','),
    ...recs.map(r => cols.map(c => '"'+(r[c]||'').replace(/"/g,'""')+'"').join(','))
  ].join('\n');
  saveAs(new Blob([csv],{type:'text/csv'}), 'TGSPDCL_Estimates_'+new Date().toISOString().slice(0,10)+'.csv');
  toast('CSV exported!');
}

// ═══════════════ CLEAR FORM ═══════════════
function clearForm() {
  document.querySelectorAll('#page-entry input:not([readonly]), #page-entry select, #page-entry textarea')
    .forEach(el => { if(el.id !== 'fy_short' && el.id !== 'fy_full' && el.id !== 'works_type' && el.id !== 'encl_desc') el.value=''; });
  document.getElementById('fy_short').value = '25-26';
  document.getElementById('fy_full').value = '2025-2026';
  document.getElementById('encl_desc').value = 'Estimate';
}

// ═══════════════ TOAST ═══════════════
function toast(msg, isErr=false) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.className = isErr ? 'err' : '';
  t.style.display = 'block';
  setTimeout(() => t.style.display='none', 3200);
}

// ═══════════════ INIT ═══════════════
window.onload = () => {
  document.getElementById('memo_date').value = new Date().toISOString().slice(0,10);
  setDocType('PM');
};

// Auto-assemble LR when any ref field changes
['f_no','lines_dno','fy_short','lines_date'].forEach(id => {
  const el = document.getElementById(id);
  if(el) el.addEventListener('input', assembleLr);
});
</script>
